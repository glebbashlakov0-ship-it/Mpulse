PORT=4000
HOST=0.0.0.0
NODE_ENV=development
APP_MODE=local
POLYMARKET_GAMMA_URL=https://gamma-api.polymarket.com
POLYMARKET_CLOB_URL=https://clob.polymarket.com
POLYMARKET_REQUEST_TIMEOUT_MS=8000
POLYMARKET_UPSTREAM_MARKET_LIMIT=500
MARKETS_DEFAULT_LIMIT=48
MARKETS_MAX_LIMIT=120
RELATED_MARKETS_LIMIT=8
MARKET_SNAPSHOT_COLLECTOR_ENABLED=false
MARKET_SNAPSHOT_COLLECTOR_INTERVAL_MS=60000
MARKET_SNAPSHOT_COLLECTOR_MARKET_IDS=
MARKET_SNAPSHOT_HISTORY_LIMIT=240
CACHE_ENABLED=true
CACHE_TTL_ACTIVE_MARKETS_MS=20000
CACHE_TTL_CLOSED_MARKETS_MS=180000
CACHE_TTL_MARKET_DETAIL_MS=20000
CACHE_TTL_CATEGORIES_MS=900000
CACHE_TTL_RELATED_MARKETS_MS=60000
CACHE_TTL_SEARCH_RESULTS_MS=20000
BLOCKED_MARKET_TERMS=
SESSION_SECRET=change-this-long-random-session-secret
SESSION_COOKIE_NAME=mp_session
SESSION_COOKIE_SECURE=false
SESSION_TTL_MS=604800000
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_PROTECTION_ENABLED=true
CSRF_COOKIE_NAME=mp_csrf
AUTH_RATE_LIMIT_WINDOW_MS=60000
AUTH_RATE_LIMIT_MAX=20
AUTH_RATE_LIMIT_BACKEND=memory
REDIS_URL=
ADMIN_EMAILS=
SUPER_ADMIN_EMAILS=
SUPPORT_EMAILS=
COMPLIANCE_ADMIN_EMAILS=
FINANCE_ADMIN_EMAILS=
ADMIN_PANEL_USERNAME=admin
ADMIN_PANEL_PASSWORD=admin
ADMIN_PANEL_COOKIE_NAME=pulse_admin_session
ADMIN_PANEL_TTL_MS=43200000
RESEND_API_KEY=local
EMAIL_FROM_ADDRESS=Market Pulse <noreply@marketpulse.app>
APP_BASE_URL=http://localhost:5173
DATABASE_URL=
DATABASE_SSL=false
# Sensitive multiline PEM. Required while the production cutover endpoint is enabled.
DATABASE_SSL_CA_PEM=

# Durable Coin outbox. Both execution modes are fail-closed by default.
# Continuous mode is for an always-on process; the bounded endpoint is for Vercel Cron.
MONEY_OUTBOX_WORKER_ENABLED=false
MONEY_OUTBOX_DRAIN_ENDPOINT_ENABLED=false
MONEY_OUTBOX_DELIVERY_MODE=disabled
# Temporary post-deploy production cutover control plane. Keep false except
# during the authenticated, operator-controlled cutover window.
PRODUCTION_COIN_CUTOVER_ENDPOINT_ENABLED=false
CRON_SECRET=
MONEY_OUTBOX_POLL_INTERVAL_MS=1000
MONEY_OUTBOX_BATCH_SIZE=50
MONEY_OUTBOX_CONCURRENCY=5
MONEY_OUTBOX_LEASE_DURATION_MS=120000
MONEY_OUTBOX_MAX_ATTEMPTS=10
MONEY_OUTBOX_BACKOFF_BASE_MS=1000
MONEY_OUTBOX_BACKOFF_MAX_MS=900000
MONEY_OUTBOX_BACKOFF_JITTER_RATIO=0.2

# Coin cutover stays review-only. These legacy credit paths must remain disabled.
LEDGER_CREDIT_API_ENABLED=false
WALLET_DEPOSIT_WEBHOOK_ENABLED=false
ADMIN_MANUAL_DEPOSIT_APPROVAL_ENABLED=false

# Explicit Coin feature gates. All are fail-closed by default, including in production.
# Review-only withdrawal requests require EXCHANGE_RATE_PROVIDER=coinbase.
# Internal trading uses only the Coin ledger and never enables Polymarket CLOB execution.
COIN_DEPOSIT_CREDITS_ENABLED=false
COIN_WITHDRAWAL_REQUESTS_ENABLED=false
COIN_INTERNAL_TRADING_ENABLED=false

# Signed Fireblocks deposit webhooks only; no private key, vault, or broadcast configuration.
# The controlling rejected launch artifact makes COIN_DEPOSIT_CREDITS_ENABLED=true
# a startup error. A future approved artifact would still require the signed webhook,
# Fireblocks provider, Coinbase rate source, and USDT TRON contract.
WALLET_DEPOSIT_MIN_CONFIRMATIONS=20
REAL_MONEY_DEPOSIT_PROVIDER=
USDT_TRON_CONTRACT=
# Use the official JWKS endpoint for the configured Fireblocks region.
# This is the US production endpoint.
FIREBLOCKS_WEBHOOK_JWKS_URL=https://keys.fireblocks.io/.well-known/jwks.json

# External conversion fails closed while disabled.
EXCHANGE_RATE_PROVIDER=disabled
EXCHANGE_RATE_TTL_SECONDS=30
EXCHANGE_RATE_REQUEST_TIMEOUT_MS=5000
EXCHANGE_RATE_COINBASE_URL=https://api.coinbase.com/v2/exchange-rates?currency=USDT

# Test-only migration/reconciliation target. Never point this at production.
COINS_MIGRATION_APPLY=false
TEST_DATABASE_URL=
TEST_DATABASE_SSL=false
