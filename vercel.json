{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run vercel-build",
  "outputDirectory": "dist-web",
  "functions": {
    "api/ops/production-coin-cutover.ts": {
      "includeFiles": "{migrations/**,releases/**}",
      "maxDuration": "max"
    },
    "api/ops/production-coin-cutover/identity.ts": {
      "includeFiles": "releases/**",
      "maxDuration": 30
    }
  },
  "crons": [
    {
      "path": "/api/cron/money-outbox",
      "schedule": "0 0 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/health",
      "destination": "/api/health"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/:path*"
    },
    {
      "source": "/((?!api/|health$).*)",
      "destination": "/index.html"
    }
  ]
}
